#!/bin/sh
# 薄壳：真正的判据在 einfacht-gate.sh（唯一入口）。
#
# 保留本文件是为了**不破坏旧装法**（`install.sh --legacy` 设 core.hooksPath
# 指向本目录时，git 找的就是这两个名字）。新装法请用 `--chain`，或直接在你的
# 钩子里调 `einfacht-gate.sh`。
set -e
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO=$(CDPATH= cd -- "$HERE/.." && pwd)
exec sh "$HERE/einfacht-gate.sh" commit "$REPO"
