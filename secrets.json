{
  "paths": [
    ".github",
    "reflect-hooks",
    "zreflect",
    "examples",
    "questions",
    "docs",
    "skills"
  ],
  "ignore_paths": [
    {"path": ".gitignore", "reason": "git ignore patterns only, no secrets"},
    {"path": "AGENTS.md", "reason": "agent workflow rules, no credentials"},
    {"path": "CODEOWNERS", "reason": "GitHub handles only"},
    {"path": "FACTS.json", "reason": "measured repo metrics and SHA seals"},
    {"path": "HISTORY.md", "reason": "project history prose"},
    {"path": "LICENSE", "reason": "MIT license text"},
    {"path": "PRINCIPLES.md", "reason": "rendered principles table"},
    {"path": "README.de.md", "reason": "German README documentation"},
    {"path": "README.md", "reason": "English README documentation"},
    {"path": "README.zh.md", "reason": "Chinese README documentation"},
    {"path": "STATE.md", "reason": "rendered state ledger"},
    {"path": "icon.svg", "reason": "SVG vector icon"},
    {"path": "knobs.json", "reason": "knob configuration values"},
    {"path": "retractions.json", "reason": "retraction ledger entries"},
    {"path": "ruff.toml", "reason": "linter configuration"},
    {"path": "secrets.json", "reason": "secret gate policy itself"}
  ],
  "allow": [
    {
      "path": "zreflect/check_secrets.py",
      "rule": "aws-access-key",
      "reason": "AWS documentation example key AKIAIOSFODNN7EXAMPLE in selftest fixture"
    },
    {
      "path": "zreflect/check_secrets.py",
      "rule": "generic-secret",
      "reason": "synthetic selftest fixture string for secret detector"
    },
    {
      "path": "examples/check_secrets/app/leaked.txt",
      "rule": "aws-access-key",
      "reason": "intentional leak example fixture for check_secrets demonstration"
    },
    {
      "path": "examples/check_secrets/example.json",
      "rule": "aws-access-key",
      "reason": "example assertion matching intentional leak fixture"
    },
    {
      "path": "zreflect/check_secrets.py",
      "rule": "private-key",
      "reason": "synthetic PEM header string in selftest fixture"
    },
    {
      "path": "zreflect/check_secrets.py",
      "rule": "jwt",
      "reason": "public JWT.io example token in selftest fixture"
    },
    {
      "path": "zreflect/check_secrets.py",
      "rule": "url-credentials",
      "reason": "synthetic URL credential fixture in selftest"
    }
  ]
}
