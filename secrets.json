{
  "paths": [
    ".github",
    "reflect-hooks",
    "zreflect",
    "examples",
    "questions",
    "docs",
    "skills"
  ],
  "ignore_paths": [
    ".gitignore",
    "AGENTS.md",
    "CODEOWNERS",
    "FACTS.json",
    "HISTORY.md",
    "LICENSE",
    "PRINCIPLES.md",
    "README.de.md",
    "README.md",
    "README.zh.md",
    "STATE.md",
    "icon.svg",
    "knobs.json",
    "retractions.json",
    "ruff.toml",
    "secrets.json"
  ],
  "allow": [
    {
      "path": "zreflect/check_secrets.py",
      "rule": "aws-access-key"
    },
    {
      "path": "zreflect/check_secrets.py",
      "rule": "generic-secret"
    },
    {
      "path": "examples/check_secrets/app/leaked.txt",
      "rule": "aws-access-key"
    },
    {
      "path": "examples/check_secrets/example.json",
      "rule": "aws-access-key"
    },
    {
      "path": "zreflect/check_secrets.py",
      "rule": "private-key"
    },
    {
      "path": "zreflect/check_secrets.py",
      "rule": "jwt"
    },
    {
      "path": "zreflect/check_secrets.py",
      "rule": "url-credentials"
    }
  ]
}
