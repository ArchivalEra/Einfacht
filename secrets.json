{
  "paths": [
    ".github",
    "reflect-hooks",
    "zreflect",
    "gates-selftest.sh",
    "examples"
  ],
  "allow": [
    {
      "path": "zreflect/check_secrets.py",
      "rule": "aws-access-key"
    },
    {
      "path": "zreflect/check_secrets.py",
      "rule": "generic-secret"
    },
    {
      "path": "examples/check_secrets/app/leaked.txt",
      "rule": "aws-access-key"
    },
    {
      "path": "examples/check_secrets/example.json",
      "rule": "aws-access-key"
    },
    {
      "path": "zreflect/check_secrets.py",
      "rule": "private-key"
    },
    {
      "path": "zreflect/check_secrets.py",
      "rule": "jwt"
    },
    {
      "path": "zreflect/check_secrets.py",
      "rule": "url-credentials"
    }
  ]
}
