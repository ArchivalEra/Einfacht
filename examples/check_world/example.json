{
  "description": "Resolve a product line and replay its environment stamps",
  "platforms": ["posix", "windows"],
  "steps": [
    {
      "argv": [
        "git",
        "init",
        "-q",
        "-b",
        "main"
      ]
    },
    {
      "argv": [
        "git",
        "add",
        "-A"
      ]
    },
    {
      "argv": [
        "git",
        "-c",
        "user.name=example",
        "-c",
        "user.email=example@invalid",
        "commit",
        "-qm",
        "baseline"
      ]
    },
    {
      "argv": [
        "{python}",
        "zreflect/check_world.py"
      ],
      "contains": [
        "world.ok(",
        "line_name='main'"
      ]
    },
    {
      "argv": [
        "{python}",
        "zreflect/check_world.py"
      ],
      "env": {
        "REFLECT_WORLD": "bad-world.json"
      },
      "rc": 1,
      "contains": [
        "world.stamp_mismatch",
        "name='site'"
      ]
    },
    {
      "argv": [
        "{python}",
        "zreflect/check_world.py"
      ],
      "env": {
        "REFLECT_WORLD": "override-wins.json",
        "REFLECT_WORLD_LINE": "edge"
      },
      "contains": [
        "world.ok(",
        "line_name='edge'"
      ]
    },
    {
      "argv": [
        "{python}",
        "zreflect/check_world.py"
      ],
      "env": {
        "REFLECT_WORLD": "no-such-world.json"
      },
      "rc": 2,
      "contains": [
        "world.knob_file_missing"
      ]
    },
    {
      "argv": [
        "git",
        "checkout",
        "-q",
        "-b",
        "release-9"
      ]
    },
    {
      "argv": [
        "{python}",
        "zreflect/check_world.py"
      ],
      "env": {
        "REFLECT_WORLD": "branch-vs-active.json"
      },
      "rc": 1,
      "contains": [
        "world.branch_mismatch",
        "active='main'"
      ]
    },
    {
      "argv": [
        "{python}",
        "zreflect/check_world.py"
      ],
      "env": {
        "REFLECT_WORLD": "branch-vs-active.json",
        "REFLECT_WORLD_LINE": "main"
      },
      "contains": [
        "world.ok(",
        "line_name='main'"
      ],
      "not_contains": [
        "world.branch_mismatch"
      ]
    }
  ]
}
