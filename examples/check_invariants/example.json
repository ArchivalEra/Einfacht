{
  "description": "Declare required and forbidden source fragments",
  "platforms": ["posix", "windows"],
  "steps": [
    {"argv": ["{python}", "zreflect/check_invariants.py"], "env": {"REFLECT_INVARIANTS": "good.json"}, "contains": ["invariants.ok"]},
    {"argv": ["{python}", "zreflect/check_invariants.py"], "env": {"REFLECT_INVARIANTS": "bad.json"}, "rc": 1, "contains": ["invariants.drift_forbidden"]},
    {"argv": ["{python}", "zreflect/check_invariants.py"], "env": {"REFLECT_INVARIANTS": "missing.json"}, "rc": 1, "contains": ["invariants.drift_missing"]}
  ]
}
